NODE_ENV=development

# Local: mongodb://127.0.0.1:27017
# MongoDB Atlas: mongodb+srv://<db-user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# URL-encode special characters in the password (@ → %40, etc.).
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=rehnumai
# MONGODB_MAX_POOL_SIZE=20

SESSION_COOKIE_NAME=rehnumai_session
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_INTAKE_TENANT_ID=demo-tenant
